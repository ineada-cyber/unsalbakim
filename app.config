<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!--
    Bazi okul aglarinda IPv6 DNS kaydi doner ama IPv6 yonlendirmesi calismaz; bu durumda
    HttpWebRequest "soket hatasi" verir (Windows Firewall'dan bagimsiz). IPv6'yi devre disi
    birakip IPv4'e zorlamak AI (Claude API) baglantisini bu makinelerde kurtarir.
  -->
  <system.net>
    <settings>
      <ipv6 enabled="false" />
      <servicePointManager expect100Continue="false" />
    </settings>
  </system.net>
</configuration>
